<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>TrapWin BEND DEMON @VERSION@</title>
    <organization>com.trapwin</organization>
    <domains enable_localSystem="true"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <welcome file="welcome.txt"/>
    <license file="license.txt"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plug-in" description="Installs to /Library/Audio/Plug-Ins/VST3 (FL Studio, Ableton, Bitwig, Reaper ...)">
        <pkg-ref id="com.trapwin.benddemon.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Installs to /Library/Audio/Plug-Ins/Components (Logic, GarageBand, FL Studio)">
        <pkg-ref id="com.trapwin.benddemon.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs BEND DEMON.app to /Applications">
        <pkg-ref id="com.trapwin.benddemon.app"/>
    </choice>

    <pkg-ref id="com.trapwin.benddemon.vst3" version="@VERSION@">BendDemon-VST3.pkg</pkg-ref>
    <pkg-ref id="com.trapwin.benddemon.au"   version="@VERSION@">BendDemon-AU.pkg</pkg-ref>
    <pkg-ref id="com.trapwin.benddemon.app"  version="@VERSION@">BendDemon-App.pkg</pkg-ref>
</installer-gui-script>
